{
    "name": "fe-router-monorepo",
    "version": "1.0.0",
    "description": "feRouter monorepo project",
    "private": true,
    "scripts": {
        "build": "pnpm -r run build",
        "dev": "pnpm -r run dev",
        "test": "pnpm -r run test",
        "lint": "eslint packages --ext .ts,.tsx,.js,.jsx --fix",
        "lint:check": "eslint packages --ext .ts,.tsx,.js,.jsx",
        "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
        "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
        "clean": "pnpm -r run clean",
        "prepare": "husky install",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "pnpm build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.1",
        "@commitlint/cli": "^18.4.3",
        "@commitlint/config-conventional": "^18.4.3",
        "@typescript-eslint/eslint-plugin": "^6.13.1",
        "@typescript-eslint/parser": "^6.13.1",
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-import": "^2.29.0",
        "eslint-plugin-prettier": "^5.0.1",
        "husky": "^8.0.3",
        "lint-staged": "^15.1.0",
        "prettier": "^3.1.0",
        "typescript": "^5.3.2"
    },
    "engines": {
        "node": ">=16.0.0",
        "pnpm": ">=8.0.0"
    },
    "packageManager": "pnpm@8.10.0"
}