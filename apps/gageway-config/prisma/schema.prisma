datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===== 应用管理模块 =====

// 应用信息表
model Application {
  id          String            @id @default(cuid())
  name        String // 应用名称
  code        String            @unique // 应用唯一标识码
  domain      String            @unique // 绑定域名
  description String? // 应用描述
  status      ApplicationStatus @default(ACTIVE) // 应用状态

  // 关联关系
  routes      Route[] // 路由配置
  permissions AppPermission[] // 应用权限
  versions    ConfigVersion[] // 配置版本
  auditLogs   AuditLog[] // 审计日志
  analytics   RouteAnalytics[] // 路由访问统计
  stats       ApplicationStats[] // 应用访问统计
  popularPaths PopularPaths[] // 热门路径统计
  systemMetrics SystemMetrics[] // 系统性能指标
  errorLogs   ErrorLog[] // 错误日志
  performanceAlerts PerformanceAlert[] // 性能警报

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // 创建者ID

  @@map("applications")
}

enum ApplicationStatus {
  ACTIVE // 活跃
  INACTIVE // 停用
  MAINTENANCE // 维护中
}

// ===== 路由配置模块 =====

// 路由主表 - 每个路由路径一条记录
model Route {
  id            String     @id @default(cuid())
  applicationId String // 应用ID
  name          String // 路由名称
  path          String // 路由路径
  method        HttpMethod @default(GET) // HTTP方法
  priority      Int        @default(0) // 优先级
  status        RouteMainStatus @default(INACTIVE) // 路由级别状态：控制整个路由是否生效

  // 当前发布的版本 - 添加 @unique 使其成为真正的一对一关系
  publishedVersionId String?       @unique // 当前发布的版本ID
  publishedVersion   RouteVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id])

  // 关联关系
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  versions       RouteVersion[]  @relation("RouteVersions")
  configVersions ConfigVersion[] // 添加这个反向关系字段
  analytics      RouteAnalytics[] // 路由访问统计
  errorLogs      ErrorLog[] // 错误日志

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // 创建者ID

  @@unique([applicationId, path, method])
  @@map("routes")
}

// 新增路由主状态枚举
enum RouteMainStatus {
  ACTIVE   // 路由生效
  INACTIVE // 路由停用
}

// 路由版本表 - 每个版本一条记录
model RouteVersion {
  id      String @id @default(cuid())
  routeId String // 路由ID
  version String // 版本号

  // 配置信息
  configType ConfigType // 配置类型
  status     RouteStatus @default(DRAFT) // 版本状态

  // 版本关系
  baseVersionId   String? // 基于哪个版本创建
  baseVersion     RouteVersion?  @relation("VersionHistory", fields: [baseVersionId], references: [id])
  derivedVersions RouteVersion[] @relation("VersionHistory")

  // 发布相关
  publishedAt DateTime? // 发布时间
  publishedBy String? // 发布者ID

  // 配置详情
  redirectConfig RedirectConfig?
  ossConfig      OssConfig?

  // 关联关系
  route            Route           @relation("RouteVersions", fields: [routeId], references: [id], onDelete: Cascade)
  publishedByRoute Route?          @relation("PublishedVersion") // 被哪个路由作为发布版本
  configVersions   ConfigVersion[] // 添加这个反向关系字段

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // 创建者ID

  @@unique([routeId, version])
  @@map("route_versions")
}

// 重定向配置表
model RedirectConfig {
  id           String  @id @default(cuid())
  versionId    String  @unique // 路由版本ID
  targetUrl    String // 目标URL
  statusCode   Int     @default(302) // HTTP状态码
  queryForward Boolean @default(true) // 是否转发查询参数
  headers      Json? // 自定义响应头

  version RouteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("redirect_configs")
}

// OSS映射配置表
model OssConfig {
  id           String  @id @default(cuid())
  versionId    String  @unique // 路由版本ID
  bucket       String // OSS存储桶
  objectKey    String // 对象键（文件路径）
  region       String? // 区域
  endpoint     String? // 自定义端点
  cacheControl String? // 缓存控制
  contentType  String? // 内容类型
  headers      Json? // 自定义响应头

  version RouteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("oss_configs")
}

enum ConfigType {
  REDIRECT // 重定向
  OSS // OSS映射
}

// 路由状态枚举需要增加草稿状态
enum RouteStatus {
  DRAFT // 草稿状态
  ACTIVE // 活跃（已发布）
  INACTIVE // 停用
  TESTING // 测试中
}

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  HEAD
  OPTIONS
  ALL // 匹配所有方法
}

// ===== 权限管理模块 =====

// 应用权限表
model AppPermission {
  id            String           @id @default(cuid())
  userId        String // 用户ID
  applicationId String // 应用ID
  role          AppRole // 角色
  permissions   PermissionType[] // 权限列表

  // 关联关系
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grantedBy String? // 授权者ID

  @@unique([userId, applicationId]) // 用户在每个应用下只能有一个权限记录
  @@map("app_permissions")
}

enum AppRole {
  OWNER // 拥有者
  ADMIN // 管理员
  EDITOR // 编辑者
  VIEWER // 查看者
}

enum PermissionType {
  READ // 读取
  WRITE // 写入
  DELETE // 删除
  DEPLOY // 部署
  ROLLBACK // 回滚
  MANAGE // 管理权限
}

// ===== 版本控制模块 =====

// 配置版本表
model ConfigVersion {
  id            String        @id @default(cuid())
  applicationId String // 应用ID
  routeId       String? // 路由ID（为空表示应用级版本）
  versionId     String? // 路由版本ID
  version       String // 版本号
  action        VersionAction // 操作类型
  description   String? // 版本描述
  configData    Json // 配置数据快照

  // 关联关系
  application  Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  route        Route?        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeVersion RouteVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String // 操作者ID

  @@map("config_versions")
}

// 操作日志表
model AuditLog {
  id            String  @id @default(cuid())
  userId        String // 操作用户ID
  applicationId String // 应用ID
  action        String // 操作类型
  resource      String // 操作资源
  resourceId    String // 资源ID
  details       Json? // 操作详情
  ipAddress     String? // IP地址
  userAgent     String? // 用户代理

  // 关联关系
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// 版本操作类型增加更多状态
enum VersionAction {
  CREATE // 创建
  UPDATE // 更新
  DELETE // 删除
  DEPLOY // 部署上线
  ROLLBACK // 回滚
  UNPUBLISH // 下线
}

// ===== NextAuth相关表（保持不变）=====

// 用户表（更新现有User表）
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Optional for WebAuthn support
  Authenticator Authenticator[]

  // 新增权限关联
  appPermissions AppPermission[]
  auditLogs      AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

