model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ===== 数据分析模块 =====

// 路由访问统计表
model RouteAnalytics {
  id            String   @id @default(cuid())
  applicationId String   // 应用ID
  routeId       String   // 路由ID
  versionId     String?  // 版本ID
  
  // 请求信息
  method        String   // HTTP方法
  path          String   // 访问路径
  statusCode    Int      // 响应状态码
  responseTime  Float    // 响应时间(ms)
  
  // 用户信息
  userAgent     String?  // 用户代理
  ip            String?  // 用户IP
  referer       String?  // 来源页面
  
  // 地理位置（可选）
  country       String?  // 国家
  city          String?  // 城市
  
  // 关联关系
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  route         Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@index([applicationId, createdAt])
  @@index([routeId, createdAt])
  @@index([createdAt])
  @@map("route_analytics")
}

// 应用访问统计汇总表（按小时/天汇总）
model ApplicationStats {
  id            String   @id @default(cuid())
  applicationId String   // 应用ID
  
  // 统计维度
  statType      StatType @default(HOURLY) // 统计类型：小时/天/月
  statTime      DateTime // 统计时间点
  
  // 统计数据
  totalRequests Int      @default(0) // 总请求数
  uniqueUsers   Int      @default(0) // 独立用户数
  avgResponseTime Float  @default(0) // 平均响应时间
  errorRate     Float    @default(0) // 错误率
  
  // 状态码统计
  status2xx     Int      @default(0) // 2xx状态码数量
  status3xx     Int      @default(0) // 3xx状态码数量
  status4xx     Int      @default(0) // 4xx状态码数量
  status5xx     Int      @default(0) // 5xx状态码数量
  
  // 关联关系
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([applicationId, statType, statTime])
  @@index([applicationId, statType, statTime])
  @@map("application_stats")
}

enum StatType {
  HOURLY  // 小时级统计
  DAILY   // 日级统计
  MONTHLY // 月级统计
}

// 热门路径统计表
model PopularPaths {
  id            String @id @default(cuid())
  applicationId String // 应用ID
  
  path          String // 路径
  requestCount  Int    @default(0) // 请求次数
  uniqueUsers   Int    @default(0) // 独立用户数
  
  // 统计时间范围
  startTime     DateTime
  endTime       DateTime
  
  // 关联关系
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([applicationId, requestCount])
  @@map("popular_paths")
}

// ===== 性能监控模块 =====

// 系统性能指标表
model SystemMetrics {
  id            String @id @default(cuid())
  applicationId String // 应用ID
  
  // 性能指标
  cpuUsage      Float    // CPU使用率 (0-100)
  memoryUsage   Float    // 内存使用率 (0-100)
  diskUsage     Float    // 磁盘使用率 (0-100)
  networkIn     Float    // 网络入流量 (MB/s)
  networkOut    Float    // 网络出流量 (MB/s)
  
  // 应用性能指标
  responseTime  Float    // 平均响应时间 (ms)
  throughput    Int      // 吞吐量 (requests/minute)
  errorCount    Int      // 错误数量
  activeUsers   Int      // 活跃用户数
  
  // 数据库性能
  dbConnections Int      // 数据库连接数
  dbQueryTime   Float    // 数据库查询时间 (ms)
  
  // 关联关系
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@map("system_metrics")
}

// 错误日志表
model ErrorLog {
  id            String    @id @default(cuid())
  applicationId String    // 应用ID
  routeId       String?   // 路由ID（可选）
  
  // 错误信息
  errorType     ErrorType // 错误类型
  severity      ErrorSeverity @default(MEDIUM) // 严重程度
  message       String    // 错误消息
  stackTrace    String?   // 堆栈跟踪
  errorCode     String?   // 错误代码
  
  // 请求信息
  method        String?   // HTTP方法
  path          String?   // 请求路径
  statusCode    Int?      // HTTP状态码
  userAgent     String?   // 用户代理
  ip            String?   // 用户IP
  
  // 环境信息
  environment   String?   // 环境标识
  version       String?   // 应用版本
  
  // 上下文信息
  userId        String?   // 用户ID（如果有）
  sessionId     String?   // 会话ID
  requestId     String?   // 请求ID
  metadata      Json?     // 额外元数据
  
  // 处理状态
  status        ErrorStatus @default(OPEN) // 处理状态
  assignedTo    String?   // 分配给
  resolvedAt    DateTime? // 解决时间
  resolvedBy    String?   // 解决者
  resolution    String?   // 解决方案
  
  // 关联关系
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  route         Route?      @relation(fields: [routeId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([applicationId, errorType, createdAt])
  @@index([severity, status, createdAt])
  @@index([createdAt])
  @@map("error_logs")
}

enum ErrorType {
  SYSTEM      // 系统错误
  APPLICATION // 应用错误
  NETWORK     // 网络错误
  DATABASE    // 数据库错误
  SECURITY    // 安全错误
  VALIDATION  // 验证错误
  TIMEOUT     // 超时错误
  GATEWAY     // 网关错误
}

enum ErrorSeverity {
  LOW         // 低级
  MEDIUM      // 中级
  HIGH        // 高级
  CRITICAL    // 严重
}

enum ErrorStatus {
  OPEN        // 未处理
  IN_PROGRESS // 处理中
  RESOLVED    // 已解决
  CLOSED      // 已关闭
  IGNORED     // 已忽略
}

// 性能警报表
model PerformanceAlert {
  id            String      @id @default(cuid())
  applicationId String      // 应用ID
  
  // 警报信息
  alertType     AlertType   // 警报类型
  severity      AlertSeverity @default(WARNING) // 严重程度
  title         String      // 警报标题
  description   String      // 警报描述
  threshold     Float?      // 阈值
  currentValue  Float?      // 当前值
  
  // 触发条件
  metricName    String      // 指标名称
  condition     AlertCondition // 条件（大于、小于等）
  duration      Int?        // 持续时间（分钟）
  
  // 状态管理
  status        AlertStatus @default(ACTIVE) // 警报状态
  acknowledgedAt DateTime? // 确认时间
  acknowledgedBy String?   // 确认者
  resolvedAt    DateTime?  // 解决时间
  resolvedBy    String?    // 解决者
  
  // 通知信息
  notificationSent Boolean @default(false) // 是否已发送通知
  notificationCount Int   @default(0)      // 通知次数
  lastNotificationAt DateTime? // 最后通知时间
  
  // 关联关系
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([applicationId, status, createdAt])
  @@index([severity, status, createdAt])
  @@index([createdAt])
  @@map("performance_alerts")
}

enum AlertType {
  CPU_HIGH       // CPU使用率过高
  MEMORY_HIGH    // 内存使用率过高
  DISK_HIGH      // 磁盘使用率过高
  RESPONSE_SLOW  // 响应时间过慢
  ERROR_RATE_HIGH // 错误率过高
  THROUGHPUT_LOW // 吞吐量过低
  DB_SLOW        // 数据库查询慢
  NETWORK_HIGH   // 网络流量过高
  UPTIME_LOW     // 可用性过低
}

enum AlertSeverity {
  INFO      // 信息
  WARNING   // 警告
  ERROR     // 错误
  CRITICAL  // 严重
}

enum AlertCondition {
  GREATER_THAN    // 大于
  LESS_THAN       // 小于
  EQUALS          // 等于
  NOT_EQUALS      // 不等于
  GREATER_EQUAL   // 大于等于
  LESS_EQUAL      // 小于等于
}

enum AlertStatus {
  ACTIVE          // 活跃
  ACKNOWLEDGED    // 已确认
  RESOLVED        // 已解决
  SUPPRESSED      // 已抑制
}
