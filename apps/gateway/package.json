{
    "name": "@fe-router/gateway",
    "version": "1.0.0",
    "description": "feRouter Gateway - 基于Node.js的路由网关系统",
    "main": "dist/main.js",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "dev": "nest start --watch",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "clean": "rimraf dist",
        "docs:serve": "docsify serve docs",
        "docker:build": "docker build -t fe-router-gateway .",
        "docker:run": "docker run -p 3000:3000 --env-file .env fe-router-gateway"
    },
    "dependencies": {
        "@nestjs/common": "^10.2.8",
        "@nestjs/core": "^10.2.8",
        "@nestjs/platform-fastify": "^10.2.8",
        "@nestjs/config": "^3.1.1",
        "@nestjs/swagger": "^7.1.16",
        "@nestjs/cache-manager": "^2.1.1",
        "@nestjs/throttler": "^5.0.1",
        "cache-manager": "^5.2.4",
        "cache-manager-redis-store": "^3.0.1",
        "ioredis": "^5.3.2",
        "ali-oss": "^6.18.0",
        "axios": "^1.6.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "helmet": "^7.1.0",
        "compression": "^1.7.4",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "joi": "^17.11.0",
        "pino": "^8.16.2",
        "pino-http": "^8.5.0",
        "pino-pretty": "^10.2.3",
        "dotenv": "^16.3.1",
        "glob": "^10.3.10",
        "mime-types": "^2.1.35",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.2.1",
        "@nestjs/schematics": "^10.0.3",
        "@nestjs/testing": "^10.2.8",
        "@types/compression": "^1.7.5",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.8",
        "@types/mime-types": "^2.1.4",
        "@types/node": "^20.9.0",
        "@types/supertest": "^2.0.16",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^6.13.1",
        "@typescript-eslint/parser": "^6.13.1",
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "jest": "^29.7.0",
        "prettier": "^3.1.0",
        "rimraf": "^5.0.5",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    },
    "keywords": [
        "gateway",
        "router",
        "nestjs",
        "oss",
        "cache",
        "proxy",
        "static-files"
    ],
    "author": "feRouter Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-org/feRouter.git",
        "directory": "apps/gateway"
    },
    "bugs": {
        "url": "https://github.com/your-org/feRouter/issues"
    },
    "homepage": "https://github.com/your-org/feRouter/tree/main/apps/gateway#readme"
}